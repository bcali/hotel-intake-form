# Supabase Configuration
# IMPORTANT: Copy this file to .env.local and fill in your actual credentials
# NEVER commit .env.local to git!

# Get these from your Supabase project dashboard:
# Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: Claude API key is stored in Supabase Edge Function secrets
# NOT in the frontend environment variables (for security)
# Set it via: supabase secrets set ANTHROPIC_API_KEY=your-key
