# Azure AD B2C Configuration (Dev Environment)
# IMPORTANT: Copy this file to .env.local and fill in your actual credentials
# NEVER commit .env.local to git!

VITE_AZURE_CLIENT_ID=your-client-id-here
VITE_AZURE_TENANT_ID=your-tenant-id-here
VITE_AZURE_CLIENT_SECRET=your-client-secret-here

# User credentials (for testing)
VITE_DEV_USER_EMAIL=your-email@minordev.com
